// 開発用コンテナ（Ubuntu 24.04）。アプリ本体は静的サイトのままで、ここで入れるものは開発・テスト用の道具だけ。
// 詳細は CLAUDE.md の「開発環境（Dev Container）」を参照。
{
	"name": "PuniPuni (Ubuntu)",
	"image": "mcr.microsoft.com/devcontainers/base:noble",

	"features": {
		// ローカルサーバー（python3 -m http.server）用
		"ghcr.io/devcontainers/features/python:1": { "version": "os-provided" },
		// 構文チェック（node --check）と Playwright MCP（npx）用
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" }
	},

	// ヘッドレス Chromium は /dev/shm が小さいと落ちるため広げる
	"runArgs": ["--shm-size=1g"],

	// VS Code がホスト側の localhost:8000 へ転送する
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": { "label": "ぷにぷに (http.server)", "onAutoForward": "notify" }
	},

	"mounts": [
		// Claude Code の設定・ログイン・プラグインを、リビルド後も保持する
		"source=punipuni-claude-config,target=/home/vscode/.claude,type=volume",
		// 流用元を「読み取り専用」で参照する（同じ親フォルダにある前提）
		"source=${localWorkspaceFolder}/../Oekaki_Suizokukan,target=/refs/oekaki,type=bind,readonly",
		"source=${localWorkspaceFolder}/../odori_tabi,target=/refs/odori,type=bind,readonly",
		"source=${localWorkspaceFolder}/../orbit_seq,target=/refs/orbit,type=bind,readonly"
	],

	// Claude Code の設定をすべて上のボリュームに置く
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},

	// Claude Code の VS Code 拡張を毎回自動で入れる
	"customizations": {
		"vscode": {
			"extensions": ["anthropic.claude-code"]
		}
	},

	// ボリュームの持ち主を直す → Claude Code の CLI を入れる → Playwright 用のブラウザと OS ライブラリを入れる
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && npm install -g @anthropic-ai/claude-code && bash .devcontainer/post-create.sh"
}